# 離線 demo 使用 mock；有網路時 LLM_PROVIDER 改 auto 並填入任一 key。切勿提交 .env
# LLM_PROVIDER 可為：mock | auto | anthropic | openai | openrouter
# 修改後按 UI 的 Reset（或 🛡安全 →「重新載入 LLM」）即可生效，不必重啟容器
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# 時間與重試類的調校（verify_wait、operator_timeout、max_attempts、detect_samples）請改 config/agent.toml，
# 這裡的 VERIFY_WAIT／OPERATOR_TIMEOUT 已不再生效。
# sim 的 reconnect 失敗訊息中的重試次數（改後需 make up 重建容器）：
# SIM_RECONNECT_RETRIES=3
