# 離線 demo 使用 mock；有網路時 LLM_PROVIDER 改 auto 並填入任一 key。切勿提交 .env
# LLM_PROVIDER 可為：mock | auto | anthropic | openai | openrouter
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
VERIFY_WAIT=7
OPERATOR_TIMEOUT=30
